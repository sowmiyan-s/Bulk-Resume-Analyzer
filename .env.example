# =============================================================================
# RESUME RADIANCE — ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. MongoDB Atlas Connection String (Required for persistent settings & history)
# Database: resume_radiance (collections: system_settings, candidate_analyses)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resume_radiance?retryWrites=true&w=majority

# 2. Admin Panel Authentication Passcode (Required)
# Access the admin hub at http://localhost:3000/admin
ADMIN_PASSWORD=123321

# 3. Server Secret Encryption Key (Optional - Fallback provided)
# 32-byte hex string used for AES-256 encryption of API keys stored in MongoDB
ENCRYPTION_SECRET=4f9b8c2d1e0a7f6e5d4c3b2a1908f7e6d5c4b3a291807f6e5d4c3b2a1098e7f6

# 4. Multi-Cloud AI Provider API Keys (Optional at env-level; can also be managed via /admin UI)
# Groq Cloud (Free · 14,400 req/day · 800+ tok/s) -> https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras Wafer-Scale (Free · 1,800+ tok/s) -> https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Qwen DashScope (1M-2M Free Tokens) -> https://home.qwencloud.com/benefits
QWEN_API_KEY=

# Google Gemini (Free · 1,500 req/day) -> https://aistudio.google.com
GEMINI_API_KEY=

# OpenRouter (:free models pool) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM (1,000 Free Credits) -> https://build.nvidia.com
NVIDIA_API_KEY=

# 5. Application Server Port
PORT=3000
